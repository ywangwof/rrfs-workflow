&data_sources
    config_geog_data_path         = '@DOMAIN_GEOG_DATA_PATH@'
    config_met_prefix             = 'HRRRE'
    config_sfc_prefix             = 'SST'
    config_fg_interval            = 3600
    config_landuse_data           = 'MODIFIED_IGBP_MODIS_NOAH_15s'
